# Grayson's Services production environment template
#
# Keep this example in Git. Create the populated production environment file
# only on the VPS, outside the repository, and restrict it to the deploy user.

# Compose
COMPOSE_PROJECT_NAME=graysons-services
CADDY_NETWORK=replace-with-the-existing-caddy-network-name

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-unique-production-secret-of-at-least-50-characters
ALLOWED_HOSTS=graysonsservices.com,www.graysonsservices.com
CORS_ALLOWED_ORIGINS=https://graysonsservices.com,https://www.graysonsservices.com
CSRF_TRUSTED_ORIGINS=https://graysonsservices.com,https://www.graysonsservices.com

# PostgreSQL
DB_NAME=graysons_services
DB_USER=graysons_services
DB_PASSWORD=replace-with-a-unique-production-database-password
DB_HOST=postgres
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=disable

# Email
RESEND_API_KEY=replace-with-the-current-resend-api-key
DEFAULT_FROM_EMAIL=replace-with-the-current-default-from-email-value
CONTACT_NOTIFICATION_EMAIL=replace-with-the-current-contact-recipient
QUOTE_NOTIFICATION_EMAIL=replace-with-the-current-quote-recipient
CAREERS_NOTIFICATION_EMAIL=replace-with-the-current-careers-recipient
EMAIL_TIMEOUT=10

# Next.js and public media
DJANGO_API_URL=http://backend:8000
NEXT_PUBLIC_DJANGO_API_URL=https://graysonsservices.com
NEXT_PUBLIC_SITE_URL=https://graysonsservices.com
MEDIA_URL=https://graysonsservices.com/media/

# Persistent container paths
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media
PRIVATE_MEDIA_ROOT=/app/private_media
DJANGO_CACHE_LOCATION=/app/cache/django

# Reverse proxy and form throttling
# Confirm DRF_NUM_PROXIES after the central Caddy/Cloudflare IP chain is tested.
DRF_NUM_PROXIES=2
CONTACT_SUBMISSION_BURST_RATE=3/minute
CONTACT_SUBMISSION_DAILY_RATE=5/day
QUOTE_REQUEST_BURST_RATE=3/minute
QUOTE_REQUEST_DAILY_RATE=5/day
JOB_APPLICATION_BURST_RATE=3/minute
JOB_APPLICATION_DAILY_RATE=5/day

# Gunicorn
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000

# HTTPS security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
