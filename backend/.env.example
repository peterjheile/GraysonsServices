# Copy this file to .env for local development.
# Generate a key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Django
SECRET_KEY=replace-with-a-local-development-secret-key
DEBUG=True

# Email
# Keep this False to print email to the terminal instead of sending it.
SEND_REAL_EMAILS=False
RESEND_API_KEY=replace-only-if-send-real-emails-is-true
DEFAULT_FROM_EMAIL=Grayson's Services <noreply@example.com>
CONTACT_NOTIFICATION_EMAIL=owner@example.com
QUOTE_NOTIFICATION_EMAIL=owner@example.com
CAREERS_NOTIFICATION_EMAIL=owner@example.com

# Optional local overrides
# SQLITE_PATH=C:/absolute/path/to/backend/db.sqlite3
# STATIC_ROOT=C:/absolute/path/to/backend/staticfiles
# MEDIA_ROOT=C:/absolute/path/to/backend/media
# PRIVATE_MEDIA_ROOT=C:/absolute/path/to/backend/private_media